# 服务监听地址与端口
HOST=0.0.0.0
PORT=18080

# 管理员登录凭据（请务必修改为强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# 会话签名密钥（留空则每次启动自动生成；建议在生产环境固定为 32+ 位随机字符串）
SESSION_SECRET=

# 对外访问的基础 URL（例如 https://relay.example.com）。
# 留空时会自动根据反向代理请求头 (X-Forwarded-Proto / X-Forwarded-Host) 推断。
PUBLIC_BASE_URL=

# 可选：GitHub Personal Access Token（用于将 API 限额从 60 次/小时提升到 5000 次/小时）
GITHUB_TOKEN=

# 数据与缓存目录
DATA_DIR=./data
CACHE_DIR=./data/cache

# Release 元数据缓存有效期（秒），默认 300 秒（5 分钟）
METADATA_TTL_SECONDS=300

# 文件缓存有效期（秒），默认 3600 秒（1 小时）
CACHE_TTL_SECONDS=3600

# 过期计时模式：
# - sliding：每次命中缓存时刷新过期时间（最后访问时间 + 1 小时）
# - fixed：从首次拉取完成时间起算 1 小时
CACHE_TTL_MODE=sliding

# 后台定时清理扫描间隔（秒），默认 300 秒（5 分钟）
CLEANUP_INTERVAL_SECONDS=300

# 缓存总容量上限（MB），默认 2048 MB（2 GB），超出后按 LRU 自动淘汰最久未使用的文件
MAX_CACHE_MB=2048

# 上游 GitHub 请求超时时间（秒），默认 300 秒
UPSTREAM_TIMEOUT_SECONDS=300
